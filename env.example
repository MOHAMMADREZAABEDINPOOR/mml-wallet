# Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=your_admin_chat_id
COLLECTION_WALLET=your_collection_wallet
TOKEN_LIMIT=100 MML
CONTACT_EMAIL=your_email@example.com

# Deployment Mode
MODE=polling
# MODE=webhook
# WEBHOOK_URL=https://your-app.herokuapp.com/webhook
# PORT=8000

# Keep-Alive Configuration
ENABLE_KEEP_ALIVE=true
PING_URL=https://your-app.herokuapp.com/
PING_INTERVAL=300

# Database
DATABASE_URL=bot.db